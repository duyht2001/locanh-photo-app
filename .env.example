# Database connection (Supabase / Neon / PostgreSQL)
# Example Supabase pooled connection (port 6543):
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Example Supabase direct connection (port 5432):
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Google Cloud Service Account Key (one-line JSON string)
# Cần cấp quyền Google Drive API và tạo Service Account Key định dạng JSON
GOOGLE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "...", "private_key_id": "...", "private_key": "...", "client_email": "...", "client_id": "..."}'

# Tài khoản & Mật khẩu Quản trị viên (Tùy chỉnh nếu muốn)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="tostudio2026"

# Supabase REST API Credentials
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
SUPABASE_SECRET_KEY="your_supabase_secret_key"
SUPABASE_JWKS_URL="https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json"
